# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Data cache (regenerable) and run state
data/cache/
data/raw/
state/*.db
state/*.sqlite
state/heartbeat.json
reports/*.png
reports/*.html

# Keep directory placeholders
!data/.gitkeep
!state/.gitkeep
!reports/.gitkeep

# OS / editors
.DS_Store
.idea/
.vscode/

# Dashboard build output that is published, not committed (recent curve chunks for the page)
reports/dashboard/lab/
