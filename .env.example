# Copy to .env and fill in. Never commit .env.

# backtest | paper | live
HIVE_MODE=paper
# Live trading additionally requires this exact phrase:
# HIVE_LIVE_CONFIRM=I_UNDERSTAND_THIS_TRADES_REAL_MONEY

# --- LLM (paid out of the bankroll) ---
ANTHROPIC_API_KEY=
HIVE_LLM_MODEL=claude-opus-5-5
HIVE_LLM_CHEAP_MODEL=claude-haiku-5-5
HIVE_LLM_EFFORT=medium

# --- Alpaca (stocks/ETFs). Paper keys from https://app.alpaca.markets ---
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# --- Hyperliquid (crypto perps). Use an API/agent wallet key (cannot withdraw). ---
# Hyperliquid's terms restrict US persons; the operator must assert eligibility.
HL_OPERATOR_NOT_RESTRICTED_PERSON=false
HL_AGENT_PRIVATE_KEY=
HL_ACCOUNT_ADDRESS=
HL_TESTNET=true

# Fetch headlines/earnings dates over the network during a run (paper/live)
HIVE_NETWORK_DATA=true

# --- optional data providers ---
FINNHUB_API_KEY=
SEC_USER_AGENT="hive-research-bot your-email@example.com"
